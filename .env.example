# ───────────────────────────────────────────────────────────────
#  Vehicle Rental System — environment variables
#  Copy this file to `.env` and fill in your real credentials.
# ───────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────
DB_PASSWORD=root

# ─── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── JWT (must be at least 32 chars) ──────────────────────────
JWT_SECRET=please-change-this-to-a-very-long-random-string-min-32-chars

# ─── Default Admin (auto-seeded on first start) ───────────────
ADMIN_EMAIL=admin@vrs.com
ADMIN_PASSWORD=Admin@123

# ─── Razorpay (Test Mode — get from https://dashboard.razorpay.com) ─
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Gmail SMTP (free — needs App Password) ───────────────────
# Set MAIL_ENABLED=false to skip sending emails (notifications still saved + WS toasts)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your.email@gmail.com
